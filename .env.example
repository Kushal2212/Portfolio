# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas or a local MongoDB. The database name is required before any
# query string, e.g. ...mongodb.net/portfolio?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://user:password@cluster0.example.mongodb.net/portfolio"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
ADMIN_EMAIL="admin@kushaldahal.dev"
ADMIN_PASSWORD="admin1234"

# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Media (optional: Cloudinary) ────────────────────────────────────────────
# Without these, uploads are stored in /public/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (optional: Resend) ────────────────────────────────────────────────
# Without this, contact messages are saved to the database only.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
CONTACT_TO_EMAIL="hello@kushaldahal.dev"

# ─── Spam protection (optional: Cloudflare Turnstile) ────────────────────────
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
