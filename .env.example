# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas or a local MongoDB. The database name is required before any
# query string, e.g. ...mongodb.net/portfolio?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://user:password@cluster0.example.mongodb.net/portfolio"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Required. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Used once to create the owner account when the database has no users.
# In production the password must be at least 12 characters. Change it from
# Admin → Settings after the first sign-in.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-long-unique-password"

# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical public URL. Must be https and must not be localhost in production.
NEXT_PUBLIC_SITE_URL="https://example.com"

# ─── Media (optional: Cloudinary) ────────────────────────────────────────────
# Without these, uploads are stored in /public/uploads. Set all three or none.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (optional: Resend) ────────────────────────────────────────────────
# Without this, contact messages are saved to the database only.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
CONTACT_TO_EMAIL="you@example.com"

# ─── Spam protection (optional: Cloudflare Turnstile) ────────────────────────
# Set both keys or neither.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ─── Seeding ─────────────────────────────────────────────────────────────────
# The demo seed script is disabled unless explicitly enabled. Never enable it
# against a real database: it writes demo posts, messages and visits.
ALLOW_DB_SEED=false
